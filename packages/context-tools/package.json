{
  "name": "@forgesworn/context-tools",
  "version": "0.3.0",
  "description": "Local CLI and MCP tools for Z1P Core encrypted context",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "bin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/context-store.d.ts",
      "import": "./dist/context-store.js"
    },
    "./mcp": {
      "types": "./dist/context-mcp.d.ts",
      "import": "./dist/context-mcp.js"
    },
    "./cli": {
      "types": "./dist/context-cli.d.ts",
      "import": "./dist/context-cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@forgesworn/context": "0.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "1.8.0",
    "typescript": "5.9.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "4.1.11"
  },
  "bin": {
    "encrypted-context": "./bin/encrypted-context.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/context.git",
    "directory": "packages/context-tools"
  },
  "homepage": "https://github.com/forgesworn/context/tree/main/packages/context-tools#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/context/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
